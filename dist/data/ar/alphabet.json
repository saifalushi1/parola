[{"id":"ar-letter-01","target":"ا","name":"alif","transliteration":"aa","native":"alif","nonConnecting":true,"forms":["ا","ا","ـا","ـا"],"notes":"Does not connect to the following letter. Long aa or a carrier for hamza.","example":{"target":"أَسَد","native":"lion"},"needsReview":true},{"id":"ar-letter-02","target":"ب","name":"baaʾ","transliteration":"b","native":"baaʾ","nonConnecting":false,"forms":["ب","بـ","ـبـ","ـب"],"notes":"Connects to both neighbors. Like b in book.","example":{"target":"بَاب","native":"door"},"needsReview":true},{"id":"ar-letter-03","target":"ت","name":"taaʾ","transliteration":"t","native":"taaʾ","nonConnecting":false,"forms":["ت","تـ","ـتـ","ـت"],"notes":"Connects to both neighbors. Like t in tea.","example":{"target":"تُفَّاحَة","native":"apple"},"needsReview":true},{"id":"ar-letter-04","target":"ث","name":"thaaʾ","transliteration":"th","native":"thaaʾ","nonConnecting":false,"forms":["ث","ثـ","ـثـ","ـث"],"notes":"Connects to both neighbors. Like th in thin.","example":{"target":"ثَوْب","native":"garment"},"needsReview":true},{"id":"ar-letter-05","target":"ج","name":"jiim","transliteration":"j","native":"jiim","nonConnecting":false,"forms":["ج","جـ","ـجـ","ـج"],"notes":"Connects to both neighbors. Usually j as in jam in MSA.","example":{"target":"جَمَل","native":"camel"},"needsReview":true},{"id":"ar-letter-06","target":"ح","name":"Haaʾ","transliteration":"H","native":"Haaʾ","nonConnecting":false,"forms":["ح","حـ","ـحـ","ـح"],"notes":"Connects to both neighbors. Breathy pharyngeal h, deeper than English h.","example":{"target":"حِصَان","native":"horse"},"needsReview":true},{"id":"ar-letter-07","target":"خ","name":"khaaʾ","transliteration":"kh","native":"khaaʾ","nonConnecting":false,"forms":["خ","خـ","ـخـ","ـخ"],"notes":"Connects to both neighbors. Like ch in Scottish loch.","example":{"target":"خُبْز","native":"bread"},"needsReview":true},{"id":"ar-letter-08","target":"د","name":"daal","transliteration":"d","native":"daal","nonConnecting":tr