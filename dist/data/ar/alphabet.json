},"needsReview":true},{"id":"ar-letter-16","target":"ط","name":"Taaʾ","transliteration":"T","native":"Taaʾ","nonConnecting":false,"forms":["ط","طـ","ـطـ","ـط"],"notes":"Connects to both neighbors. An emphatic t.","example":{"target":"طَائِر","native":"bird"},"needsReview":true},{"id":"ar-letter-17","target":"ظ","name":"DHaaʾ","transliteration":"DH","native":"DHaaʾ","nonConnecting":false,"forms":["ظ","ظـ","ـظـ","ـظ"],"notes":"Connects to both neighbors. An emphatic voiced th.","example":{"target":"ظَهْر","native":"back"},"needsReview":true},{"id":"ar-letter-18","target":"ع","name":"ʿayn","transliteration":"ʿ","native":"ʿayn","nonConnecting":false,"forms":["ع","عـ","ـعـ","ـع"],"notes":"Connects to both neighbors. A voiced pharyngeal sound; no exact English equivalent.","example":{"target":"عَيْن","native":"eye"},"needsReview":true},{"id":"ar-letter-19","target":"غ","name":"ghayn","transliteration":"gh","native":"ghayn","nonConnecting":false,"forms":["غ","غـ","ـغـ","ـغ"],"notes":"Connects to both neighbors. A voiced counterpart of kh.","example":{"target":"غُرْفَة","native":"room"},"needsReview":true},{"id":"ar-letter-20","target":"ف","name":"faaʾ","transliteration":"f","native":"faaʾ","nonConnecting":false,"forms":["ف","فـ","ـفـ","ـف"],"notes":"Connects to both neighbors. Like f in fine.","example":{"target":"فِيل","native":"elephant"},"needsReview":true},{"id":"ar-letter-21","target":"ق","name":"qaaf","transliteration":"q","native":"qaaf","nonConnecting":false,"forms":["ق","قـ","ـقـ","ـق"],"notes":"Connects to both neighbors. A deep k from the back of the tongue.","example":{"target":"قَلَم","native":"pen"},"needsReview":true},{"id":"ar-letter-22","target":"ك","name":"kaaf","transliteration":"k","native":"kaaf","nonConnecting":false,"forms":["ك","كـ","ـكـ","ـك"],"notes":"Connects to both neighbors. Like k in key.","example":{"target":"كِتَاب","native":"book"},"needsReview":true},{"id":"ar-letter-23","target":"ل","name":"laam","transliteration":"l","native":"laam","nonConnecting":false,"forms":["ل","لـ","ـلـ","ـل"],"notes":"Connects to both neighbors. Like l in leaf.","example":{"target":"لَيْمُون","native":"lemon"},"needsReview":true},{"id":"ar-letter-24","target":"م","name":"miim","transliteration":"m","native":"miim","nonConnecting":false,"forms":["م","مـ","ـمـ","ـم"],"notes":"Connects to both neighbors. Like m in moon.","example":{"target":"مَاء","native":"water"},"needsReview":true},{"id":"ar-letter-25","target":"ن","name":"nuun","transliteration":"n","native":"nuun","nonConnecting":false,"forms":["ن","نـ","ـنـ","ـن"],"notes":"Connects to both neighbors. Like n in night.","example":{"target":"نَجْمَة","native":"star"},"needsReview":true},{"id":"ar-letter-26","target":"ه","name":"haaʾ","transliteration":"h","native":"haaʾ","nonConnecting":false,"forms":["ه","هـ","ـهـ","ـه"],"notes":"Connects to both neighbors. Like h in hat.","example":{"target":"هَاتِف","native":"phone"},"needsReview":true},{"id":"ar-letter-27","target":"و","name":"waaw","transliteration":"w","native":"waaw","nonConnecting":true,"forms":["و","و","ـو","ـو"],"notes":"Does not connect to the following letter. w, or long uu.","example":{"target":"وَلَد","native":"boy"},"needsReview":true},{"id":"ar-letter-28","target":"ي","name":"yaaʾ","transliteration":"y","native":"yaaʾ","nonConnecting":false,"forms":["ي","يـ","ـيـ","ـي"],"notes":"Connects to both neighbors. y, or long ii.","example":{"target":"يَد","native":"hand"},"needsReview":true}]